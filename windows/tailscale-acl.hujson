// Sala de Tela: política de acesso do Tailscale.
// Cole em https://login.tailscale.com/admin/acls/file e troque IP_DO_SERVIDOR
// pelo IP que o setup-linux.sh mostrou (tailscale ip -4).
{
  // Só você (admin) pode criar chaves com essa tag.
  "tagOwners": {
    "tag:amigo": ["autogroup:admin"],
  },

  "hosts": {
    "sala": "IP_DO_SERVIDOR",
  },

  "grants": [
    // Você acessa tudo na sua rede.
    {"src": ["autogroup:member"], "dst": ["*"], "ip": ["*"]},

    // Os amigos só alcançam a Sala de Tela no seu PC (página, WebRTC e mídia),
    // e não alcançam nada além disso (nem uns aos outros).
    {"src": ["tag:amigo"], "dst": ["sala"], "ip": ["tcp:8080", "tcp:8889", "udp:8189"]},
  ],
}
